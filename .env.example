# ─── Next.js website ─────────────────────────────────────────────────────────
# The site reads blogs from Strapi and posts the contact form to it. These are
# server-side only and are never sent to the browser.
#
# There are deliberately NO AWS credentials here. Amazon SES is called from
# Strapi, never from this application. See cms/.env.example.

# Where Strapi is running. In production this is the public CMS URL.
STRAPI_URL=http://localhost:1337

# Optional. Only needed if you lock the Blog collection behind an API token
# instead of the public role. Create one in Strapi: Settings > API Tokens.
# STRAPI_TOKEN=

# Seconds Next caches CMS responses for before checking again. Default 60.
# STRAPI_REVALIDATE=60

# Hostnames allowed to load `next dev` assets cross-origin. Needed only when
# you reach the dev server through a tunnel or another machine — ngrok, a
# Cloudflare tunnel, or your LAN IP. Without it the dev server answers every
# /_next/static request with 403, React never hydrates, and nothing on the page
# is clickable. Comma separated; protocol and path are ignored.
#
# ALLOWED_DEV_ORIGINS=urgent-delta-utility.ngrok-free.dev,192.168.1.11
