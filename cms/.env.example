HOST=0.0.0.0
PORT=1337

# ─── Production address ──────────────────────────────────────────────────────
# The public URL of this CMS, e.g. https://cms.dropskip.ai. The website's
# STRAPI_URL should point at the same address.
# PUBLIC_URL=

# Leave true when a reverse proxy or host terminates HTTPS in front of Strapi
# (nginx, a load balancer, Render, Railway...). Set false only if Strapi itself
# is exposed directly to the internet.
# IS_PROXIED=true

# Extra browser origins allowed to call this API, comma separated. Nothing on
# the website needs it — it talks to Strapi server-side — so leave it unset
# unless another browser app must reach the API.
# CORS_ORIGINS=

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Generate fresh values for every environment, e.g.  openssl rand -base64 32
# APP_KEYS takes several such values, comma separated.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ─── Database ────────────────────────────────────────────────────────────────
# config/database.js falls back to sqlite when DATABASE_CLIENT is unset, so a
# deployment that forgets these starts on a local file and loses its content on
# the next redeploy. Set them explicitly anywhere that is not a dev machine.
#
# DATABASE_CLIENT is one of: sqlite, postgres, mysql.

DATABASE_CLIENT=sqlite

# sqlite only — path is relative to the cms directory.
DATABASE_FILENAME=.tmp/data.db

# postgres and mysql only. Ignored when the client is sqlite.
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=
# DATABASE_SSL=false

# A single connection string, used in place of the six settings above when set.
# DATABASE_URL=

# ─── Amazon SES ──────────────────────────────────────────────────────────────
# The ONLY place AWS credentials exist in this project. Used by
# src/api/inquiry/services/ses.js to email contact form inquiries.
#
# On EC2, ECS or App Runner, leave the key and secret blank and attach an IAM
# role with the ses:SendEmail permission instead.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Must be an address or domain you have verified in Amazon SES.
SES_FROM_EMAIL=no-reply@dropskip.ai

# Where inquiries are received.
SES_TO_EMAIL=support@dropskip.ai
