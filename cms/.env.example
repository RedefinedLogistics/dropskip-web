HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ─── Database ────────────────────────────────────────────────────────────────
# config/database.js falls back to sqlite when DATABASE_CLIENT is unset, so a
# deployment that forgets these starts on a local file and loses its content on
# the next redeploy. Set them explicitly anywhere that is not a dev machine.
#
# DATABASE_CLIENT is one of: sqlite, postgres, mysql.

DATABASE_CLIENT=sqlite

# sqlite only — path is relative to the cms directory.
DATABASE_FILENAME=.tmp/data.db

# postgres and mysql only. Ignored when the client is sqlite.
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=
# DATABASE_SSL=false

# A single connection string, used in place of the six settings above when set.
# DATABASE_URL=

# ─── Amazon SES ──────────────────────────────────────────────────────────────
# The ONLY place AWS credentials exist in this project. Used by
# src/api/inquiry/services/ses.js to email contact form inquiries.
#
# On EC2, ECS or App Runner, leave the key and secret blank and attach an IAM
# role with the ses:SendEmail permission instead.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Must be an address or domain you have verified in Amazon SES.
SES_FROM_EMAIL=no-reply@dropskip.ai

# Where inquiries are received.
SES_TO_EMAIL=support@dropskip.ai
