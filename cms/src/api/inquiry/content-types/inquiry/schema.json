{
  "kind": "collectionType",
  "collectionName": "inquiries",
  "info": {
    "singularName": "inquiry",
    "pluralName": "inquiries",
    "displayName": "Inquiry",
    "description": "Contact form submissions from dropskip.ai"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 120 },
    "email": { "type": "email", "required": true, "maxLength": 160 },
    "phone": { "type": "string", "maxLength": 40 },
    "company": { "type": "string", "required": true, "maxLength": 160 },
    "subject": { "type": "string", "maxLength": 160 },
    "message": { "type": "text", "maxLength": 4000 },
    "source": { "type": "string", "maxLength": 40, "default": "contact" },
    "notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the SES notification was sent for this inquiry"
    }
  }
}
